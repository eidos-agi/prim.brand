{
  "type": "object",
  "properties": {
    "version": {
      "const": "0.2.0"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "principal": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "decision": {
            "enum": [
              "approve",
              "reject",
              "supersede"
            ]
          },
          "scope": {
            "enum": [
              "reference",
              "asset",
              "release"
            ]
          },
          "subjects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "asset_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "record_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "asset_id",
                "sha256",
                "record_sha256"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "release_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "evidence": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\x00:%?#]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "principal",
          "at",
          "decision",
          "scope",
          "evidence"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "scope": {
                  "const": "release"
                }
              }
            },
            "then": {
              "required": [
                "release_sha256"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "scope": {
                  "enum": [
                    "reference",
                    "asset"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "subjects"
              ],
              "properties": {
                "subjects": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "version",
    "decisions"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
